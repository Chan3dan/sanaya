# Application
SANAYA_ENV=development
SANAYA_LOG_LEVEL=INFO
SANAYA_DASHBOARD_PORT=3000
SANAYA_API_PORT=3001
SANAYA_CORE_PORT=8000

# Database
DATABASE_URL=sqlite:///./data/sqlite/sanaya.db
REDIS_URL=redis://localhost:6379
CHROMA_PATH=./data/chroma

# AI Providers (moved to OS keychain after first run)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODELS=./data/ollama/models

# AI Defaults
DEFAULT_AI_PROVIDER=ollama
PRIVACY_MODE=false
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:0.5b

# Voice
WHISPER_MODEL=base
TTS_PROVIDER=coqui
WAKE_WORD_SENSITIVITY=0.5
WAKE_WORD_MODEL=./data/models/wake_word/hey_sanaya.onnx

# Security
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRY=24h
MEMORY_ENCRYPTION=true
